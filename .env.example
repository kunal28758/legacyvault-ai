# LegacyVault AI — environment template (task T008).
# Copy to .env.local for local development. .env.local is git-ignored and must never be
# committed (constitution I, XIX). Every value below is a PLACEHOLDER — no real secrets.
# The schema lives in lib/config/env.schema.ts; run `pnpm env:check` to validate.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Clerk (ADR-003) — dashboard checklist: docs/DEPLOYMENT.md § Clerk (T195) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# ── Supabase (ADR-002 / ADR-005) — checklist: docs/DEPLOYMENT.md § Supabase (T196)
# Local stack (pnpm db:start) prints these values; SUPABASE_SECRET_KEY is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# ── Application cryptography (constitution IV, ADR-014) ────────────────────────
# Format: <keyId>:<base64 of 32 random bytes>. Generate material with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=k1:REPLACE_WITH_BASE64_32_BYTES
# Optional, only during a key rotation window (T240): previous key, different keyId.
# ENCRYPTION_KEY_PREVIOUS=k0:REPLACE_WITH_BASE64_32_BYTES
# Base64 of 32 random bytes, dedicated to the access cookie (never reuse ENCRYPTION_KEY).
ACCESS_COOKIE_KEY=REPLACE_WITH_BASE64_32_BYTES

# ── AI providers (ADR-008) — keys are server-only, never NEXT_PUBLIC_ ─────────
# Configure at least one (production requires one). With both, the default is
# the primary and the other takes over during an outage. Placeholder values
# (…REPLACE_ME) count as "not configured": AI panels then say so honestly and
# every non-AI feature keeps working. Model ids are optional overrides.
OPENAI_API_KEY=sk-REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
AI_DEFAULT_PROVIDER=openai
# OPENAI_MODEL=gpt-5.4-mini
# GEMINI_MODEL=gemini-2.5-flash

# ── Email (ADR-009) ────────────────────────────────────────────────────────────
# All three are required together: the application treats email as unconfigured
# unless the whole group validates, and then reports `emailSent: false` rather
# than pretending a message went out. EMAIL_WEBHOOK_SECRET signs the delivery
# events that POST /api/webhooks/email records.
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="LegacyVault AI <no-reply@example.com>"
EMAIL_WEBHOOK_SECRET=REPLACE_ME

# ── Observability (ADR-010) — optional locally, required in production ────────
# instrumentation.ts / instrumentation-client.ts initialise Sentry only when the
# matching DSN is set, so leaving these empty is a supported configuration.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Internal automation (ADR-006): ≥ 32 characters ─────────────────────────────
CRON_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# ── Malware scanning (ADR-015): production refuses `noop` ─────────────────────
# clamd must accept streams as large as the largest upload: set
# `StreamMaxLength 500M` in clamd.conf (videos are up to 500 MB). A larger file
# is refused by clamd and the upload is rejected with a clear reason.
MALWARE_SCANNER_PROVIDER=noop
# CLAMAV_HOST=clamav.internal
# CLAMAV_PORT=3310
# CLAMAV_TLS=false

# ── Operations ────────────────────────────────────────────────────────────────
# Clerk user promoted to SUPER_ADMIN by scripts/seed-admin.ts (T033).
ADMIN_EMAIL=admin@example.com
